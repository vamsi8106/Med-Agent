LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LOG_LEVEL=INFO
DATABASE_PATH=medagent.db
CHROMA_PERSIST_DIR=.chroma

LANGCHAIN_TRACING_V2=false
