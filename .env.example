LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LOG_LEVEL=INFO
POSTGRES_DSN=postgresql://medagent:medagent@localhost:5432/medagent

# Each MCP server runs as its own container; defaults match the service DNS
# names used in docker-compose.yml / k8s Service names -- use these values
# when medagent itself also runs inside docker-compose (`docker compose up`).
MEDICAL_MCP_URL=http://medical-mcp-bridge:8080
HEALTHCARE_MCP_URL=http://healthcare-mcp:3000
RESEARCH_MCP_URL=http://research-mcp:3000

# ChromaDB runs as its own server container, shared safely across replicas.
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- Bare local dev alternative ---
# Running medagent directly on the host (`make serve`) instead of inside
# docker-compose? Start just the backing services --
#   docker compose up -d postgres chromadb healthcare-mcp research-mcp medical-mcp-bridge
# (or `make docker-up-deps`) -- then override the container-DNS values above
# with these host-port equivalents (each service also maps a host port for
# exactly this):
# MEDICAL_MCP_URL=http://localhost:8081
# HEALTHCARE_MCP_URL=http://localhost:3001
# RESEARCH_MCP_URL=http://localhost:3002
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# POSTGRES_DSN=postgresql://medagent:medagent@localhost:5432/medagent

# Distributed tracing. Spans are always created (they carry the trace_id that
# correlates log lines) but only exported when an OTLP/HTTP endpoint is set. In
# docker-compose this points at the bundled Tempo; view traces in Grafana ->
# Explore -> Tempo. Traces and logs never contain patient data.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_CONSOLE_EXPORTER=false
OTEL_SAMPLE_RATIO=1.0

# WARNING: LangSmith tracing sends prompts -- which contain patient data -- to a
# third-party service. Leave this off for anything but synthetic data.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medagent

GRAFANA_ADMIN_PASSWORD=admin

# Generate a real secret for any non-local deployment: openssl rand -hex 32
JWT_SECRET_KEY=dev-insecure-secret-change-me-in-prod-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Bounds on outbound calls, so a hung upstream never stalls a request forever.
LLM_TIMEOUT_SECONDS=30
# Retry policy for the LLM and MCP servers. A rate limit that asks for a wait
# longer than RETRY_MAX_WAIT_SECONDS fails fast instead of holding the request;
# retrying stops once RETRY_BUDGET_SECONDS have been spent in total:
RETRY_MAX_WAIT_SECONDS=10
RETRY_BUDGET_SECONDS=45
MCP_TIMEOUT_SECONDS=30

# Context/cost controls for LLM calls. Token counts are estimates (3.5
# chars/token, measured against real usage). Size these to your Groq tier's
# per-request limit: the free on_demand tier for openai/gpt-oss-20b is 8000
# tokens, and the prompt plus the model's reasoning/completion must fit.
# Total LLM tokens one assess/followup run may spend before remaining
# specialist agents are skipped (noted in the report):
AGENT_MAX_TOKENS_PER_RUN=8000
# Cap on any one piece of external text (an MCP response) entering a prompt:
AGENT_CONTEXT_FIELD_MAX_TOKENS=1000
# Final cap on a fully-assembled prompt before it is sent:
AGENT_PROMPT_MAX_TOKENS=4000
# Cap on each past visit's report when replayed into a prompt as history:
AGENT_VISIT_SUMMARY_MAX_TOKENS=250
# How long a drafted report waits for the doctor's approve/reject/edit over the
# WebSocket (surviving a dropped connection) before it is discarded from memory:
APPROVAL_DRAFT_TTL_MINUTES=30
# Whole-loop deadline for the ReAct evidence agent; on expiry it falls back to
# the fixed retrieve-then-summarize pipeline (per-call timeouts alone let a hung
# provider hold a multi-turn loop for minutes):
AGENT_LOOP_TIMEOUT_SECONDS=40

# Free medical APIs behind the MCP servers have low rate ceilings -- throttles
# outbound calls per MCP server before they ever hit retry.
MCP_RATE_LIMIT_PER_SECOND=5
MCP_RATE_LIMIT_CAPACITY=10

# Seeds exactly one admin account on first startup (only if the users table
# is empty). There is no public registration endpoint -- every other account
# must be created by an admin via POST /admin/users. Leave both blank to skip
# bootstrapping (e.g. once an admin already exists).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-deploy
